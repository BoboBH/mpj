#!/bin/bash
# Git credential helper using GITHUB_TOKEN environment variable

# Read the protocol from stdin
read -r protocol
read -r host

# Check if it's GitHub and GITHUB_TOKEN is set
if [ "$host" = "github.com" ] && [ -n "$GITHUB_TOKEN" ]; then
    echo "protocol=https"
    echo "host=github.com"
    echo "username=oauth2"
    echo "password=$GITHUB_TOKEN"
else
    # Fall back to normal credential handling
    echo "protocol=$protocol"
    echo "host=$host"
fi
